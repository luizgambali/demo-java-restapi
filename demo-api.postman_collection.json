{
  "info": {
    "_postman_id": "e14f4315-56f3-401f-ac96-526c07a74c9d",
    "name": "Demo API REST",
    "description": "Coleção para a API REST de exemplo com Spring Boot e JWT.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "token", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "customerId", "value": "" }
  ],
  "item": [
    {
      "name": "Autenticação",
      "item": [
        {
          "name": "Cadastrar usuário",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"usuario.demo\",\n  \"password\": \"senha-forte-123\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Login",
          "event": [{
            "listen": "test",
            "script": { "exec": ["const body = pm.response.json();", "pm.collectionVariables.set('token', body.token);", "pm.collectionVariables.set('userId', body.id);"] }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"usuario.demo\",\n  \"password\": \"senha-forte-123\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/auth/login"
          }
        }
      ]
    },
    {
      "name": "Clientes",
      "item": [
        {
          "name": "Listar clientes",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/customers" }
        },
        {
          "name": "Criar cliente",
          "event": [{
            "listen": "test",
            "script": { "exec": ["const body = pm.response.json();", "pm.collectionVariables.set('customerId', body.id);"] }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Cliente Exemplo\",\n  \"address\": \"Rua das Flores, 100\",\n  \"city\": \"São Paulo\",\n  \"country\": \"Brasil\",\n  \"zipcode\": \"01001-000\",\n  \"phone\": \"11999999999\",\n  \"email\": \"cliente@example.com\",\n  \"active\": true\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/customers"
          }
        },
        {
          "name": "Buscar cliente por ID",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/customers/{{customerId}}" }
        },
        {
          "name": "Atualizar cliente",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Cliente Exemplo Atualizado\",\n  \"address\": \"Rua das Flores, 101\",\n  \"city\": \"São Paulo\",\n  \"country\": \"Brasil\",\n  \"zipcode\": \"01001-000\",\n  \"phone\": \"11988888888\",\n  \"email\": \"cliente.atualizado@example.com\",\n  \"active\": true\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/customers/{{customerId}}"
          }
        },
        {
          "name": "Excluir cliente",
          "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/customers/{{customerId}}" }
        }
      ]
    },
    {
      "name": "Usuários",
      "item": [
        {
          "name": "Buscar meu usuário",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/users/get-by-id/{{userId}}" }
        },
        {
          "name": "Alterar minha senha",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"usuario.demo\",\n  \"oldpassword\": \"senha-forte-123\",\n  \"newpassword\": \"nova-senha-forte-123\",\n  \"confirmpassword\": \"nova-senha-forte-123\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/users/change-password"
          }
        }
      ]
    },
    {
      "name": "Administração",
      "description": "Informe manualmente adminToken após fazer login com um usuário ADMIN.",
      "item": [
        {
          "name": "Listar usuários",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/users/get-all" }
        },
        {
          "name": "Criar administrador",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"novo.admin\",\n  \"password\": \"senha-admin-forte-123\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/users/create-admin"
          }
        },
        {
          "name": "Excluir usuário",
          "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/users/delete/{{userId}}" }
        }
      ]
    }
  ]
}
